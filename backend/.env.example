# ==============================================================================
# HAVENKEEP MULTI-PROVIDER CONFIGURATION
# Configure supplier API keys, custom base URLs, and role model bindings.
# ==============================================================================

# System Settings
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./havenkeep.db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# SUPPLIER API KEYS & CUSTOM BASE URLS
# ------------------------------------------------------------------------------

# 1. Anthropic (Claude 3.5 Sonnet, Claude 3 Haiku, Claude 3.7)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 2. OpenAI (GPT-4o, GPT-4o-mini, o3-mini, or local vLLM / LM Studio / LocalAI)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=http://localhost:8000/v1

# 3. Google Gemini (gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash)
GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_BASE_URL=

# 4. Groq (llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=

# 5. OpenRouter (deepseek/deepseek-r1, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 6. Ollama (100% Free Local Models: gemma3:latest, qwen2.5-coder:3b, llama3)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# ROLE MODEL BINDINGS (Assign any supplier to any role)
# Supported Providers: "anthropic", "openai", "google", "groq", "openrouter", "ollama"
# (Model name is optional — if omitted, the provider's standard model is used automatically)
# ------------------------------------------------------------------------------

# Supervisor Router Role (Scoring & Risk Routing)
SUPERVISOR_PROVIDER=ollama
# SUPERVISOR_MODEL=gemma3:latest

# Planner Role (Task Decomposition & Reasoning)
PLANNER_PROVIDER=anthropic
# PLANNER_MODEL=claude-3-5-sonnet-20240620

# Worker Role (Fast Execution & Tool Execution)
WORKER_PROVIDER=ollama
WORKER_MODEL=gemma3:latest
# WORKER_MODEL=gpt-4o-mini

# Critic Role (Rubric Check & Quality Evaluation)
CRITIC_PROVIDER=ollama
CRITIC_MODEL=gemma3:latest

# Executor Role (Final Output & Delivery)
EXECUTOR_PROVIDER=openai
EXECUTOR_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# BUDGET ENFORCEMENT LIMITS (USD)
# ------------------------------------------------------------------------------
DEFAULT_SESSION_SOFT_BUDGET=0.50
DEFAULT_SESSION_HARD_BUDGET=2.00
DEFAULT_TASK_HARD_BUDGET=1.00
